{
  "schemaVersion": 1,
  "components": [
    {
      "fileName": "pointoflight-*.exe",
      "description": "Point of Light companion executable",
      "install": "{localappdata}/PointOfLight/pointoflight.exe"
    }
  ],
  "launch": {
    "executable": "{localappdata}/PointOfLight/pointoflight.exe",
    "args": [
      "--halo-path", "{game:halo-infinite}",
      "--ori-path",  "{game:ori-and-the-will-of-the-wisps}"
    ]
  },
  "games": [
    "halo-infinite",
    "ori-and-the-will-of-the-wisps"
  ]
}
