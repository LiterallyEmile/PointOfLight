{
  "schemaVersion": 1,
  "components": [
    {
      "fileName": "pointoflight-*.exe",
      "label": "Point of Light",
      "install": "{managed}/pointoflight.exe"
    }
  ],
  "launch": {
    "executable": "{managed}/pointoflight.exe",
    "args": [
      "--halo-path", "{game:custom-halo-infinite-campaign}",
      "--ori-path",  "{game:custom-ori-and-the-will-of-the-wisps}"
    ]
  },
  "games": [
    "custom-halo-infinite-campaign",
    "custom-ori-and-the-will-of-the-wisps"
  ]
}
